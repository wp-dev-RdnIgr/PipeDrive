{
  "name": "Pipedrive DB Manager",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pipedrive-db",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "wh-db-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 400],
      "webhookId": "pipedrive-db-api"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.body.query }}",
        "options": {}
      },
      "id": "sql-001",
      "name": "Execute SQL",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [480, 400],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "Postgres_DB_for_n8n-claude"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              {"name": "Access-Control-Allow-Origin", "value": "*"}
            ]
          }
        }
      },
      "id": "resp-db-001",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 400]
    }
  ],
  "connections": {
    "Webhook": {"main":[[{"node":"Execute SQL","type":"main","index":0}]]},
    "Execute SQL": {"main":[[{"node":"Respond","type":"main","index":0}]]}
  },
  "settings": {"executionOrder": "v1"}
}
